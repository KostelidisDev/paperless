# Paperless-ngx stack — keep this file out of git (chmod 600 .env)

# Required
DOMAIN=paperless.kostelidis.dev
# Must stay the same once set — changing it logs everyone out and breaks signed links
PAPERLESS_SECRET_KEY=secret
# Must match the existing database user's password
POSTGRES_PASSWORD=paperless

# Image source
PAPERLESS_IMAGE="ghcr.io/kostelidisdev/paperless"
PAPERLESS_IMAGE_TAG="3.2.1"
TIKA_IMAGE="ghcr.io/kostelidisdev/paperless-tika"
TIKA_IMAGE_TAG="4.1.0-full"

# Third-party images — pin exact releases
POSTGRES_TAG=18.6
VALKEY_TAG=9-alpine
GOTENBERG_TAG=8

# Database identity — must match the existing database
POSTGRES_DB=paperless
POSTGRES_USER=paperless

# Access control (web UI and API)
IPV4_ALLOWLIST=0.0.0.0/0
IPV6_ALLOWLIST=::/0

# Networks — dual-stack; subnets must not overlap other Docker networks on the host
# Frontend network (shared with Traefik)
PAPERLESS_NETWORK_SUBNET_V4=10.100.0.0/24
PAPERLESS_NETWORK_SUBNET_V6=fd00:100::/64
# Internal backend network (database, broker, Gotenberg, Tika)
PAPERLESS_BACKEND_NETWORK_SUBNET_V4=10.100.0.0/24
PAPERLESS_BACKEND_NETWORK_SUBNET_V6=fd00:100:1::/64

# OCR
PAPERLESS_OCR_LANGUAGE=ell+eng
# Keep TASK_WORKERS x THREADS_PER_WORKER at or below PAPERLESS_CPU_LIMIT
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=2

# Optional overrides
TZ=Europe/Athens
PAPERLESS_CPU_LIMIT=2
PAPERLESS_MEMORY_LIMIT=2G
PAPERLESS_MEMORY_RESERVATION=512M
PAPERLESS_PIDS_LIMIT=1024
PAPERLESS_POSTGRES_CPU_LIMIT=1
PAPERLESS_POSTGRES_MEMORY_LIMIT=512M
PAPERLESS_POSTGRES_MEMORY_RESERVATION=256M
PAPERLESS_POSTGRES_PIDS_LIMIT=256
PAPERLESS_BROKER_CPU_LIMIT=0.5
PAPERLESS_BROKER_MEMORY_LIMIT=128M
PAPERLESS_BROKER_MEMORY_RESERVATION=64M
PAPERLESS_BROKER_PIDS_LIMIT=64
PAPERLESS_GOTENBERG_CPU_LIMIT=1
PAPERLESS_GOTENBERG_MEMORY_LIMIT=1G
PAPERLESS_GOTENBERG_MEMORY_RESERVATION=256M
PAPERLESS_GOTENBERG_PIDS_LIMIT=512
PAPERLESS_TIKA_CPU_LIMIT=1
PAPERLESS_TIKA_MEMORY_LIMIT=1G
PAPERLESS_TIKA_MEMORY_RESERVATION=256M
PAPERLESS_TIKA_PIDS_LIMIT=512
PAPERLESS_TIKA_HEAP_PERCENT=60